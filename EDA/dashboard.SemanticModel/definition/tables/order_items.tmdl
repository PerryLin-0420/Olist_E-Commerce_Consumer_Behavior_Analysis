table order_items
	lineageTag: 91a74103-c31b-49db-b1f4-44bbd62223b4

	measure seller_with_repeate =
			
			CALCULATE(
			    DISTINCTCOUNT(order_items[seller_id]),
			    order_items[seller_cust_days]>=2
			    )
		formatString: 0
		lineageTag: dc80bfb5-056e-4934-bd91-7e9c6791bddc

	measure seller_repeate_rate =
			
			DIVIDE([seller_with_repeate], DISTINCTCOUNT(order_items[seller_id]))
		lineageTag: 92f2ede2-8006-4f3d-ae8b-9eebdf5c7c6d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column order_id
		dataType: string
		lineageTag: 9f03a97d-e348-4b3e-8067-045454e690ad
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

