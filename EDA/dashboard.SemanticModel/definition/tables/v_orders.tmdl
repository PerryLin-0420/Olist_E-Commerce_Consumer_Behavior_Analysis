table v_orders
	lineageTag: bf5e1892-1a77-4b64-84a1-d222a2307fcb

	measure orders_valid =
			
			CALCULATE (
			    DISTINCTCOUNT ( v_orders[order_id] ),
			    NOT ( v_orders[order_status] IN { "canceled", "unavailable" } )
			)
		formatString: 0
		lineageTag: b8bf4bc3-1e4d-4ae6-9b5f-dd7085b9a203

	measure revenue_valid =
			
			CALCULATE (
			    SUM ( v_orders[payment_value] ),
			    NOT ( v_orders[order_status] IN { "canceled", "unavailable" } )
			)
		lineageTag: 55bef6aa-2a59-45ab-8431-19b6737fe2b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure aov = DIVIDE ( [revenue_valid], [orders_valid] )
		lineageTag: 90b2feda-9cdd-43a1-9298-87bda565e314

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure repeat_rate =
			
			DIVIDE (
			    CALCULATE ( DISTINCTCOUNT ( v_orders[customer_unique_id] ), v_orders[purchase_days] >= 2 ),
			    DISTINCTCOUNT ( v_orders[customer_unique_id] )
			)
		lineageTag: da5babaf-8e22-4019-ab9c-496a28183adc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

