		sourceColumn: payment_value

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column orders =
			CALCULATE(
			    DISTINCTCOUNT(order_payments[order_id]),
			    ALLEXCEPT(order_payments, v_orders[customer_unique_id])
			)
		formatString: 0
		lineageTag: 959e6740-9092-44b4-bd5b-1ad10ab2b3cc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column purchase_seq = ```
			
			 VAR d = INT ( v_orders[purchased_at])
			 VAR custdate = 
			    CALCULATETABLE(
			        SELECTCOLUMNS(v_orders, "purchase_date", INT( v_orders[purchased_at])),
			        ALLEXCEPT(v_orders, v_orders[customer_unique_id])
			    )
			 RETURN
			COUNTROWS(FILTER(DISTINCT(custdate), [purchase_date] <= d))
			```
		formatString: 0
		lineageTag: da8c60cc-e235-450d-8fb1-423ebad1eb19
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column weekday_no = WEEKDAY(v_orders[purchased_at],2)
		formatString: 0
		lineageTag: 731a1286-95dd-4183-95d0-6b5fa1aba463
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column weekday_name = FORMAT(v_orders[purchased_at],"ddd")
		lineageTag: 2a21c43f-3885-4863-bfd7-21b5d79f9454
		summarizeBy: none
		sortByColumn: weekday_no

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column hour = HOUR(v_orders[purchased_at])
		formatString: 0
		lineageTag: 0f2704ee-ebfa-4b13-9a6c-79d9eb1842e5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column cell = (WEEKDAY(v_orders[purchased_at],2)-1)*24+HOUR(v_orders[purchased_at])
		formatString: 0
		lineageTag: f38da834-ee81-4cbb-986c-7321c71bd3be
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column year_month = FORMAT ( v_orders[purchased_at], "YYYY-MM" )
		lineageTag: 299b7742-e99c-44c3-9e05-73adee009cec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column purchase_days =
			
			VAR custDates =
			    CALCULATETABLE (
			        SELECTCOLUMNS ( v_orders, "purchase_date", INT ( v_orders[purchased_at] ) ),
			        ALLEXCEPT ( v_orders, v_orders[customer_unique_id] )
			    )
			RETURN
			    COUNTROWS ( DISTINCT ( custDates ) )
		formatString: 0
		lineageTag: c4b3a4a6-f0e0-4cc4-9a8e-1c3ae639147e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column customer_tier =
			
			SWITCH (
			    TRUE (),
			    v_orders[purchase_days] = 1, "1 次",
			    v_orders[purchase_days] = 2, "2 次",
			    v_orders[purchase_days] = 3, "3 次",
			    "4 次以上"
			)
		lineageTag: 4c7b63f6-538c-4030-a736-ffa556377942
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

