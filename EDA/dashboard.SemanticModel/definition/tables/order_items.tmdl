	column shipping_limit_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 38c5ff05-13f9-4abe-ba87-71efbbb91476
		summarizeBy: none
		sourceColumn: shipping_limit_date

		variation 變化
			isDefault
			relationship: 190b8e4f-098f-4dfa-a247-e10bcdffa041
			defaultHierarchy: LocalDateTable_410fe679-c2f8-47a6-a667-0d59ca154137.日期階層

		annotation SummarizationSetBy = Automatic

	column price
		dataType: double
		lineageTag: 4d9e9698-b593-4609-82cf-1c0cb4f27416
