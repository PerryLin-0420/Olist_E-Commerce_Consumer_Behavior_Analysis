		sourceColumn: price

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column freight_value
		dataType: double
		lineageTag: ecf79f78-6a66-473c-ad2d-74e3614e734a
		summarizeBy: sum
		sourceColumn: freight_value

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column customer_id = RELATED(customers[customer_unique_id])
		lineageTag: b41f89a9-aa9a-4754-9f8f-672d80515000
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column seller_state = RELATED(sellers[seller_state])
		lineageTag: 9dceb2f5-4552-4b49-b593-495620c033f2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column buy_date =
			
			IF(
			    RELATED(orders[order_status]) IN {"canceled", "unavailable"},
			    BLANK(),
			    INT(RELATED(v_orders[purchased_at]))
			    )
		formatString: 0
		lineageTag: df1be98c-8061-4e8a-b20a-91d2c8e50570
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column seller_cust_days =
			CALCULATE(
			    DISTINCTCOUNTNOBLANK(order_items[buy_date]),
			    ALLEXCEPT(order_items, order_items[seller_id], order_items[customer_id])
			)
		formatString: 0
		lineageTag: fca99389-5f4c-40ee-b19d-c88e8e48343d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column seller_customer =
			CALCULATE(
			    DISTINCTCOUNT(order_items[customer_id]),
			    ALLEXCEPT(order_items, sellers[seller_id])
			    )
		formatString: 0
		lineageTag: 67c7a3e6-a215-4b57-a760-203226079b26
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition order_items = m
		mode: import
		source =
				let
				    來源 = GoogleBigQuery.Database([Implementation="2.0", BillingProject="olist-511414"]),
				    #"olist-511414_Database" = 來源{[Name="olist-511414",Kind="Database"]}[Data],
				    olist_Schema = #"olist-511414_Database"{[Name="olist",Kind="Schema"]}[Data],
